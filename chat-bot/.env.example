# ---------------------------------------------------------------------------
# Chat Bot — environment configuration
# Copy to .env and fill in. Never commit the real .env.
# Variables already set in the process environment take precedence over this file.
# ---------------------------------------------------------------------------

# --- Server ------------------------------------------------------------------

# Port the app listens on.
PORT=3002

# Public URL of this app (used in the Web Chat script shown to users and for secure cookies).
# Leave empty to use the URL the page was opened with.
CHAT_BOT_PUBLIC_URL=https://chat.example.com

# --- Database ----------------------------------------------------------------

# PostgreSQL: use a new, empty database. Tables are created on first start.
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatbot

# --- Workspace ---------------------------------------------------------------

# Owner of the workspace. Created on first start if it doesn't exist.
ADMIN_EMAIL=admin@example.com

# Optional: pin the workspace ID. Empty = use the admin's oldest workspace (created if none).
CHAT_BOT_WORKSPACE_ID=

# --- Access ------------------------------------------------------------------

# Sign-in for the app. Fall back to ADMIN_EMAIL / ADMIN_PASSWORD when empty.
LOGIN_USERNAME=admin@example.com
LOGIN_PASSWORD=replace-with-a-strong-password
# ADMIN_PASSWORD=

# Signs the sign-in session cookie. At least 32 characters.
NEXTAUTH_SECRET=replace-with-a-random-64-char-string

# Token for other systems calling the management API: Authorization: Bearer <API_TOKEN>
API_TOKEN=replace-with-a-random-token

# --- Chat webhook (Redis + worker) ---------------------------------------------

# Every chat message is queued on Redis and POSTed here by the worker.
# Empty = messages are not queued.
CHAT_WEBHOOK_URL=https://your-backend.example.com/api/v1/WebChat

# Redis for the "chat-webhook" queue (used by the app and the worker).
REDIS_URL=redis://localhost:6379

# --- Web Chat integrations -----------------------------------------------------

# When a Web Chat starts: POST { ip, publicId } here; the returned JSON object
# prefills variables with the same names. Empty = disabled.
SAVE_WEBCHAT_CONTACT_URL=

# Live agent messages. Shared secret with your Socket.IO server; empty = disabled.
WIDGET_JWT_SECRET=
# Token lifetime (e.g. 30m, 24h, 7d). Default 24h.
# WIDGET_JWT_EXPIRES_IN=24h
# Socket.IO server the Web Chat connects to (include http:// or https://).
NEXT_PUBLIC_LIVE_AGENT_SOCKET_HOST=

# Optional: service used to find the network's public IP when visitors are on the same LAN.
# PUBLIC_IP_LOOKUP_URL=https://api.ipify.org?format=json

# --- Integration blocks ---------------------------------------------------------

# Exactly 32 characters. Encrypts saved accounts (SMTP, Stripe, Google Sheets, Gmail).
# Keep it forever: changing it makes saved accounts unreadable.
ENCRYPTION_SECRET=replace-with-exactly-32-characters

# Default SMTP server for "Send email" blocks (the "Default" account).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
# SMTP_IGNORE_TLS=false
# SMTP_AUTH_DISABLED=false
NEXT_PUBLIC_SMTP_FROM="Chat Bot <notifications@example.com>"

# Google OAuth clients (Google Cloud console). Authorized redirect URI for both:
#   <CHAT_BOT_PUBLIC_URL>/api/v1/credentials/oauth/callback
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Uploads -------------------------------------------------------------------------

# Folder for files uploaded by visitors (file input) and images uploaded in the builder.
UPLOADS_DIR=uploads
# Maximum size of one visitor upload, in MB.
NEXT_PUBLIC_BOT_FILE_UPLOAD_MAX_SIZE=10

# --- Embedded builder -------------------------------------------------------------

# Sites allowed to show the builder in an iframe WITHOUT login, comma-separated
# (exact origins, e.g. https://app.example.com). Iframe URL:
#   <CHAT_BOT_PUBLIC_URL>/chat-bots/<chatBotId>/edit?embed=true
# Checked with the browser's Referer header: scripts can fake it, so anyone who knows a chat bot
# id and an allowed origin can open that builder. Empty = embedding off.
EMBED_ALLOWED_ORIGINS=

# Signed-token mode (disabled in code, see server/embed.ts): the parent backend signs
# { chatBotId, exp } with this secret and adds &token=… to the iframe URL.
# EMBED_TOKEN_SECRET=
